# Cross-Platform Security Lab - Environment Template
# Copy this file to .env and adjust values for your local environment.

# Controller Binding (WSL2 / Linux Server)
LAB_CONTROLLER_HOST=0.0.0.0
LAB_CONTROLLER_PORT=4444

# Client Connection Target
LAB_CLIENT_HOST=127.0.0.1
LAB_CLIENT_PORT=4444

# Telemetry Reporting Interval (seconds)
LAB_STATUS_INTERVAL=10

# Cryptographic Material Directory
LAB_CERTS_DIR=certs

# Logging Verbosity: DEBUG, INFO, WARNING, ERROR
LAB_LOG_LEVEL=INFO
